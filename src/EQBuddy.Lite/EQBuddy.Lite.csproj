<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The product is EQdps (renamed pre-launch, v1.53.0): its own exe, installer
         identity, and release asset names, distinct from the original EQBuddy. -->
    <AssemblyName>EQdps</AssemblyName>
    <RootNamespace>EQBuddy.Lite</RootNamespace>
    <!-- Version comes from Directory.Build.props (repo root). -->
    <ApplicationIcon>..\EQBuddy\Assets\EQBuddy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQBuddy.Core\EQBuddy.Core.csproj" />
  </ItemGroup>

</Project>
