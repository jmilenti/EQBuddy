<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same assembly name as the full app on purpose: the installer, shortcuts, and
         the auto-updater all know the product as EQBuddy.exe, so Lite slots into the
         existing install/update channel without touching either. -->
    <AssemblyName>EQBuddy</AssemblyName>
    <RootNamespace>EQBuddy.Lite</RootNamespace>
    <!-- Version comes from Directory.Build.props (repo root). -->
    <ApplicationIcon>..\EQBuddy\Assets\EQBuddy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQBuddy.Core\EQBuddy.Core.csproj" />
  </ItemGroup>

</Project>
