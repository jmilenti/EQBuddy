<Window x:Class="EQBuddy.Lite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQdps"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="ActionPill" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#AEBBC7"/>
        </Style>

        <!-- Chrome-less button for the feed's search row (All / + / chip ✕): the stock
             Button template is system-light and ignores a dark panel's palette. -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <!-- A dropdown wearing the action pill's clothes (unused since the scope
             dropdown retired — each GROUP board is permanently one scope now — but
             kept templated for the next pill-row dropdown). -->
        <Style x:Key="PillComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#AEBBC7"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="Transparent"
                                CornerRadius="4" Padding="7,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#E8F1F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#AEBBC7"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Wide enough for the longest option, so picking one doesn't reflow the
                 pill row under it. -->
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PillComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="#14FFFFFF"
                                                BorderBrush="#1EFFFFFF" BorderThickness="1"
                                                CornerRadius="6">
                                            <TextBlock Text="▾" FontSize="9" Foreground="#8A97A3"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,7,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#30FFFFFF"/>
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#55FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#30FFFFFF"/>
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#55FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="7,2,20,2" VerticalAlignment="Center"
                                              TextElement.Foreground="#AEBBC7"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False" Focusable="False">
                                <Border Background="#F0141A20" BorderBrush="#3CFFFFFF"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="2" Margin="0,3,0,0">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#F0101418" BorderBrush="#3CFFFFFF" BorderThickness="1"
            CornerRadius="10"
            MouseLeftButtonDown="OnDrag">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Border.LayoutTransform>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="VersionItem" IsEnabled="False"/>
                <MenuItem Header="Check for updates" Click="OnCheckUpdatesMenu"/>
                <MenuItem Header="Group sync…" Click="OnGroupSyncMenu"/>
                <MenuItem Header="Reset session" Click="OnResetSession"/>
                <MenuItem Header="Reset window layout" Click="OnResetLayout"/>
                <Separator/>
                <MenuItem Header="Exit" Click="OnClose"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
        <StackPanel x:Name="RootStack" MinWidth="235" Margin="14,10,14,12">
            <DockPanel Margin="0,0,0,6">
                <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="8" Height="8"
                         Fill="#666" VerticalAlignment="Center" Margin="0,1,7,0"/>
                <Button DockPanel.Dock="Right" Content="✕" Click="OnClose"
                        Background="Transparent" BorderThickness="0" Foreground="#8A97A3"
                        FontSize="11" Padding="4,0" Cursor="Hand"/>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="10"
                           Foreground="#55616C" VerticalAlignment="Center"
                           Margin="6,1,4,0"/>
                <TextBlock x:Name="TitleText" Text="EQdps" FontWeight="SemiBold"
                           Foreground="#DDE5EC" FontSize="13"/>
            </DockPanel>

            <WrapPanel Margin="0,0,0,6">
                <Border Style="{StaticResource ActionPill}" ToolTip="Group sync settings"
                        MouseLeftButtonDown="OnSyncPill">
                    <TextBlock Style="{StaticResource ActionPillText}" Text="⇄"/>
                </Border>
                <Border Style="{StaticResource ActionPill}" ToolTip="Reset session stats"
                        MouseLeftButtonDown="OnResetSessionPill">
                    <TextBlock Style="{StaticResource ActionPillText}" Text="↺"/>
                </Border>
                <Border Style="{StaticResource ActionPill}" ToolTip="Reset window layout"
                        MouseLeftButtonDown="OnResetLayoutPill">
                    <TextBlock Style="{StaticResource ActionPillText}" Text="▦"/>
                </Border>
                <Border Style="{StaticResource ActionPill}" ToolTip="Check for updates"
                        MouseLeftButtonDown="OnUpdatePill">
                    <TextBlock Style="{StaticResource ActionPillText}" Text="⟳"/>
                </Border>
                <Border Style="{StaticResource ActionPill}"
                        ToolTip="Settings — which features read group sync vs your own log"
                        MouseLeftButtonDown="OnSettingsPill">
                    <TextBlock Style="{StaticResource ActionPillText}" Text="⚙"/>
                </Border>
            </WrapPanel>

            <TextBlock x:Name="UpdateBanner" Visibility="Collapsed" Cursor="Hand"
                       MouseLeftButtonDown="OnUpdateClick" TextWrapping="Wrap"
                       Foreground="#8BE28B" FontSize="12" Margin="0,0,0,6"/>

            <TextBlock x:Name="DpsText" Text="⚔ 0 dps" FontSize="21"
                       Foreground="White" FontWeight="SemiBold"/>
            <!-- The breakdown itself is a side popup (key "own:", anchored to this
                 window) rather than an inline list — a long ability list was pushing
                 every section below it down the screen. -->
            <TextBlock x:Name="DamageHeader" Visibility="Collapsed" Cursor="Hand"
                       FontSize="9.5" Foreground="#7B8794" Margin="0,4,0,0"
                       ToolTip="Click for your full damage breakdown (opens beside the panel)"
                       MouseLeftButtonDown="OnBreakdownToggle"/>
            <TextBlock x:Name="PetText" Text="🐾 no pet" FontSize="13"
                       Foreground="#B8C4CE" Margin="0,3,0,0"/>
            <StackPanel x:Name="MotesSection">
                <Rectangle x:Name="MotesTopSep" Height="1" Fill="#2AFFFFFF" Margin="0,9,0,7"/>
                <TextBlock x:Name="MotesHeader" Text="MOTES · none yet" Cursor="Hand"
                           FontSize="9.5" Foreground="#A8985A"
                           ToolTip="Click to show/hide · drag to pop out"/>
                <!-- One aligned table, players down and tiers across (RenderMotesTable):
                     the loot race is a comparison, and a comparison wants columns —
                     per-player indented tier lists made everyone count for themselves. -->
                <Grid x:Name="MotesTable" Margin="2,4,0,0" Visibility="Collapsed"
                      ToolTip="Group rows come over sync — your log never sees anyone else's loot"/>
            </StackPanel>

            <StackPanel x:Name="LootSection">
                <Rectangle x:Name="LootTopSep" Height="1" Fill="#2AFFFFFF"
                           Margin="0,9,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="LootHeader" Visibility="Collapsed" Cursor="Hand"
                           FontSize="9.5" Foreground="#7B8794" Margin="0,7,0,0"
                           ToolTip="Click to show/hide · drag to pop out"/>
                <ItemsControl x:Name="LootList" Margin="4,2,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5"
                                       Foreground="#9FB0BE"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel x:Name="FightsSection">
            <Rectangle x:Name="FightsTopSep" Height="1" Fill="#2AFFFFFF"
                       Margin="0,9,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="FightsHeader" Visibility="Collapsed" Cursor="Hand"
                       FontSize="9.5" Foreground="#7B8794" Margin="0,7,0,0"
                       ToolTip="Click to show/hide · drag to pop out · click a fight for its breakdown"/>
            <ItemsControl x:Name="FightsList" Margin="4,2,0,0" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="7,2" Margin="0,1"
                                BorderThickness="1" Cursor="Hand"
                                ToolTip="Click for this fight's breakdown"
                                MouseLeftButtonDown="OnFightRowClick">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#30FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                       Foreground="#B9C8D6"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <StackPanel x:Name="SpawnSection" Visibility="Collapsed">
                <Rectangle x:Name="SpawnTopSep" Height="1" Fill="#2AFFFFFF" Margin="0,9,0,7"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock x:Name="SpawnHeader" Cursor="Hand" FontSize="9.5"
                               Foreground="#7B8794"
                               ToolTip="Click to show/hide · drag to pop out · click a timer for details"/>
                    <!-- Spawn timers survive a session reset on purpose (a respawn is
                         real-world time), so clearing a camp gets its own action here. -->
                    <TextBlock x:Name="SpawnClearLink" Text="↺ clear" Cursor="Hand"
                               FontSize="9.5" Margin="10,0,0,0"
                               ToolTip="Clear every spawn timer on this server — session reset leaves them running on purpose"
                               MouseLeftButtonDown="OnClearSpawns">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#55616C"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#E8CE9C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ItemsControl x:Name="SpawnList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="7,3" Margin="0,1"
                                    BorderThickness="1" Cursor="Hand"
                                    ToolTip="Click for spawn details"
                                    MouseLeftButtonDown="OnSpawnRowClick">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#14FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#30FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Due}"
                                               FontFamily="Consolas" FontSize="12.5"
                                               Foreground="#E8CE9C" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               Foreground="#E8CE9C"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel x:Name="GroupSection">
            <Rectangle x:Name="GroupTopSep" Height="1" Fill="#2AFFFFFF" Margin="0,9,0,7"/>

            <TextBlock x:Name="GroupLabel" Text="GROUP · from your log, near you" FontSize="9.5"
                       Foreground="#7B8794" Margin="0,0,0,3" Cursor="Hand"
                       ToolTip="Click to show/hide · drag to pop out"/>
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="7,3" Margin="0,1"
                                BorderThickness="1" Cursor="Hand"
                                ToolTip="Click for their breakdown"
                                MouseLeftButtonDown="OnGroupRowClick">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#30FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12.5"
                                       Foreground="#CFE3F5"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="GroupEmptyText" Text="(no group activity nearby)"
                       FontFamily="Consolas" FontSize="12.5" Foreground="#7B8794"/>
            </StackPanel>

            <!-- The second GROUP board: same roster, session clock (the one above is
                 the fight clock). Popups opened from a board stay in that board's
                 scope. -->
            <StackPanel x:Name="Group2Section">
            <Rectangle x:Name="Group2TopSep" Height="1" Fill="#2AFFFFFF" Margin="0,9,0,7"/>

            <TextBlock x:Name="Group2Label" Text="GROUP · session" FontSize="9.5"
                       Foreground="#7B8794" Margin="0,0,0,3" Cursor="Hand"
                       ToolTip="Click to show/hide · drag to pop out"/>
            <ItemsControl x:Name="Group2List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="7,3" Margin="0,1"
                                BorderThickness="1" Cursor="Hand"
                                ToolTip="Click for their breakdown"
                                MouseLeftButtonDown="OnGroupRowClick">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#30FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12.5"
                                       Foreground="#CFE3F5"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="Group2EmptyText" Text="(no group activity nearby)"
                       FontFamily="Consolas" FontSize="12.5" Foreground="#7B8794"/>
            </StackPanel>

            <StackPanel x:Name="FeedSection">
                <Rectangle x:Name="FeedTopSep" Height="1" Fill="#2AFFFFFF" Margin="0,9,0,7"/>
                <TextBlock x:Name="FeedHeader" Text="▸ FEED · live" Cursor="Hand"
                           FontSize="9.5" Foreground="#7B8794"
                           ToolTip="Click to show/hide · drag to pop out · a live feed of combat from your log, with filters"/>
                <!-- Search chips row (BuildFeedSearch): [all] [chip ✕]… [box] [+].
                     Typed words become removable chips, Outlook-recipient style. -->
                <WrapPanel x:Name="FeedSearchRow" Visibility="Collapsed"
                           Margin="0,4,0,0" MaxWidth="340"/>
                <!-- Filter pills are built in code (BuildFeedPills) — ~16 toggles would
                     drown the XAML, and they all share one tiny template anyway. -->
                <WrapPanel x:Name="FeedPillRow" Visibility="Collapsed"
                           Margin="0,2,0,2" MaxWidth="340"/>
                <!-- A ListBox rather than ItemsControl for its built-in ScrollViewer and
                     virtualization — the buffer holds 2000 events and only the viewport
                     should ever pay render cost. Selection chrome is templated away. -->
                <ListBox x:Name="FeedList" Margin="2,2,0,0" Visibility="Collapsed"
                         MaxWidth="340" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                       FontFamily="Consolas" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="FeedEmptyText" Text="(nothing matching yet)" Visibility="Collapsed"
                           FontFamily="Consolas" FontSize="11.5" Foreground="#7B8794"/>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="ResizeGrip" Text="◢" FontSize="10" Foreground="#55616C"
                   Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,4,2" ToolTip="Drag to resize · double-click to reset"
                   MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove"
                   MouseLeftButtonUp="OnGripUp"/>
        </Grid>
    </Border>
</Window>
